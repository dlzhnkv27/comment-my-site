{
  "manifest_version": 3,
  "name": "Comment My Site",
  "version": "1.1.0",
  "description": "Комментарии к любой странице как в Figma: маркеры на странице и экспорт полного скриншота с ними.",
  "key": "",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Оставить комментарий (⌥⇧C)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "offscreen",
    "nativeMessaging"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      }
    }
  }
}
